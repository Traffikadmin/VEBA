{
  "family": "veba-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/veba-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/veba-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "veba",
      "image": "ACCOUNT_ID.dkr.ecr.us-west-1.amazonaws.com/veba:staging-latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "WP_ENV",          "value": "staging" },
        { "name": "DB_HOST",         "value": "YOUR_RDS_ENDPOINT_HERE" },
        { "name": "DB_NAME",         "value": "veba_staging" },
        { "name": "DB_USER",         "value": "veba_staging" },
        { "name": "WP_TABLE_PREFIX", "value": "wp_" }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-west-1:ACCOUNT_ID:secret:veba/staging/db-password"
        },
        {
          "name": "WP_SALTS",
          "valueFrom": "arn:aws:secretsmanager:us-west-1:ACCOUNT_ID:secret:veba/staging/wp-salts"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/veba/staging",
          "awslogs-region": "us-west-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost/health.php || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
