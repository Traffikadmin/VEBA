{
  "family": "veba-dev",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::061664787177:role/veba-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::061664787177:role/veba-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "veba",
      "image": "061664787177.dkr.ecr.us-west-1.amazonaws.com/veba:dev-latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "WP_ENV",          "value": "development" },
        { "name": "DB_HOST",         "value": "veba-dev.c7ysso8uahzd.us-west-1.rds.amazonaws.com" },
        { "name": "DB_NAME",         "value": "veba-dev" },
        { "name": "DB_USER",         "value": "admin" },
        { "name": "WP_TABLE_PREFIX", "value": "wp_" }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-west-1:061664787177:secret:veba/dev/db-password-oCo78U"
        },
        {
          "name": "WP_SALTS",
          "valueFrom": "arn:aws:secretsmanager:us-west-1:061664787177:secret:veba/dev/wp-salts-1NndG5"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/veba/dev",
          "awslogs-region": "us-west-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost/health.php || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
